{
  "name": "@medikiosk/api",
  "version": "0.1.0",
  "private": true,
  "description": "MediKiosk modular-monolith API: domain, intelligence, safety and interoperability layers.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "@medikiosk/auth": "*",
    "@medikiosk/clinical-schema": "*",
    "@medikiosk/evidence-model": "*",
    "@medikiosk/fhir-models": "*",
    "@medikiosk/i18n": "*",
    "@medikiosk/safety-rules": "*",
    "@medikiosk/shared-types": "*",
    "better-sqlite3": "^13.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
