# ============================================================================
# MediKiosk environment template.  Copy to `.env` and fill in.
# NEVER commit a real `.env` file.  NEVER commit production secrets.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# development | test | production
MEDIKIOSK_DEPLOYMENT_MODE=local
# local | staging | production

# --- HTTP API --------------------------------------------------------------
API_PORT=8080
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:8080
KIOSK_ORIGIN=http://localhost:5173
CONSOLE_ORIGIN=http://localhost:5174

# --- Database --------------------------------------------------------------
# dev/demo (no Docker required):   MEDIKIOSK_DB_DIALECT=sqlite
# production (Postgres):           MEDIKIOSK_DB_DIALECT=postgres
MEDIKIOSK_DB_DIALECT=sqlite
MEDIKIOSK_SQLITE_PATH=./.medikiosk-data/medikiosk.sqlite
# DATABASE_URL=postgres://medikiosk:change-me@db:5432/medikiosk

# --- Secrets ---------------------------------------------------------------
# MUST be replaced in any non-local deployment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MEDIKIOSK_JWT_SECRET=dev-only-insecure-jwt-secret-replace-me
MEDIKIOSK_SESSION_ENCRYPTION_KEY=dev-only-insecure-session-key-replace-me
MEDIKIOSK_HASH_PEPPER=dev-only-insecure-pepper-replace-me

# Session / retention policy
MEDIKIOSK_SESSION_TTL_MINUTES=45
MEDIKIOSK_TEMP_RETENTION_MINUTES=120

# --- Identity provider -----------------------------------------------------
# mock  = deterministic local identity (DEMO ONLY, never claims to be ABHA)
# abha  = real ABDM ABHA adapter (requires approved sandbox credentials)
IDENTITY_PROVIDER=mock
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_ENVIRONMENT=sandbox

# --- AI providers ----------------------------------------------------------
# Each provider is independently switchable. `mock` is fully deterministic and
# requires no network. `disabled` turns the capability off entirely.
LLM_PROVIDER=mock
# mock | openai | ollama | disabled
LLM_MODEL=medikiosk-deterministic-v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

ASR_PROVIDER=browser
# browser | bhashini | mock | disabled
ASR_MODEL=browser-webspeech-v1

OCR_PROVIDER=mock
# mock | tesseract-local | disabled
OCR_MODEL=medikiosk-synthetic-ocr-v1

TTS_PROVIDER=browser
# browser | mock | disabled

NER_PROVIDER=deterministic
# deterministic | llm | disabled

# --- Feature flags (overridable per tenant in the admin console) -----------
FEATURE_VOICE_ENABLED=true
FEATURE_TTS_ENABLED=true
FEATURE_DOCUMENT_AI_ENABLED=true
FEATURE_AYUSH_ENABLED=true
FEATURE_ABDM_ENABLED=false
FEATURE_OFFLINE_ENABLED=true
FEATURE_LOCAL_LLM_ENABLED=false
FEATURE_RESEARCH_MODE_ENABLED=true

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
# fatal | error | warn | info | debug | trace
LOG_PHI=false
# When false (default) clinical free-text is redacted from logs.
METRICS_ENABLED=true
