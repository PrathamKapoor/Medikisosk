{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "packages/**/*.test.ts",
    "services/**/*.test.ts",
    "services/api/src/testing/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
