{
  "name": "@medikiosk/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Localisation layer: translation keys, Indian-language catalogues, controlled clinical terminology.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "verify": "node -e \"require('./dist/verify').verifyAllLocales()\""
  },
  "dependencies": {
    "@medikiosk/shared-types": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
